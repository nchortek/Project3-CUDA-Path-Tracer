#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "gpu/shared.h"
#include "common.glsl"
#include "rng.glsl"
#include "math.glsl"
#include "bsdf.glsl"

layout(set = kRendererDescriptorSet, binding = kTLASBinding) uniform accelerationStructureEXT TLAS;
layout(set = kRendererDescriptorSet, binding = kAccumImageBinding, rgba32f) uniform image2D accumImage;
layout(set = kRendererDescriptorSet, binding = kDisplayImageBinding, rgba8) uniform image2D displayImage;

layout(push_constant, scalar) uniform PushConstantBlock
{
    PushConstants pc;
};

// Raygen owns the payload, so this is rayPayloadEXT rather than the
// rayPayloadInEXT used by our closest-hit and miss shaders.
// The location must match the last argument of traceRayEXT.
layout(location = 0) rayPayloadEXT IntersectionInfo payload;

SurfaceInteraction sceneIntersect(Ray ray);
vec3 Li_Naive(Ray ray);

void main()
{
    initSeed(gl_LaunchIDEXT, gl_LaunchSizeEXT, pc.renderedFrameCount);

    // gl_LaunchIDEXT (0,0) is the top-left image pixel,
    // and +y increases down the screen.
    const vec2 pixel = vec2(gl_LaunchIDEXT.xy);
    const vec2 halfResolution = vec2(gl_LaunchSizeEXT.xy) * 0.5;

    // NCHORTEK TODO: This needs to be consistent with saveImage pixel calcs
    const vec3 direction = normalize(
        pc.camera.view
        + pc.camera.right * pc.camera.pixelLength.x * (pixel.x - halfResolution.x)
        - pc.camera.up * pc.camera.pixelLength.y * (pixel.y - halfResolution.y));

    const vec3 origin = pc.camera.position;

    vec3 sampleColor = Li_Naive(Ray(origin, direction));

    if (pc.renderedFrameCount > 0)
    {
        vec3 prevAvg = imageLoad(accumImage, ivec2(pixel)).rgb;
        sampleColor = mix(prevAvg, sampleColor, 1.0 / float(pc.renderedFrameCount + 1));
    }

    imageStore(accumImage, ivec2(pixel), vec4(sampleColor, 1.0));

    // Apply Reinhard and gamma correction to the display image.
    // Note we do NOT apply this to the accumulation image, because
    // that should deal with full "physically-correct" light energy
    vec3 corrected = sampleColor.rgb / (1.f + sampleColor.rgb);
    corrected = pow(corrected, vec3(1.f / 2.2f));
    vec4 displayColor = vec4(corrected.rgb, 1.f);

    imageStore(displayImage, ivec2(pixel), displayColor);
}

SurfaceInteraction sceneIntersect(Ray ray)
{
    SurfaceInteraction surface;

    // Set the miss sentinel before tracing, so a miss is correct even for traces
    // where no shader writes the payload
    payload.t = kMiss;

    traceRayEXT(
        TLAS,
        gl_RayFlagsNoneEXT,
        kInstanceMaskAllBitsSet,
        0,
        0,
        0,
        ray.origin,
        kTMin,
        ray.direction,
        kTMax,
        0);

    surface.isect = payload;

    // Return early on a miss
    if (surface.isect.t == kMiss)
    {
        surface.material = kEmptyMaterial;
        return surface;
    }
    
    // Set the material to what was hit
    SceneAddresses sceneAddresses = SceneAddressesBuffer(pc.sceneAddr).deviceAddresses;
    surface.material = MaterialBuffer(sceneAddresses.materialsAddr).materials[payload.materialIndex];

    if (surface.material.type != kSpecTrans
        && surface.material.type != kSpecGlass)
    {
        // Non-transmissive types build their local frame around the normal
        // and assume wo is on the +z side. If the ray hits the surface from
        // the side opposite its stored normal, this results in sampled directions
        // incorrectly landing on the far side of the surface. To fix this, we
        // flip the normal direction to face the incoming ray for intersections
        // in this edge case.
        //
        // Note that we do not want to perform this flip for transmissive types,
        // because transmissive BSDF functions use the sign of wo.z to determine if
        // a ray is entering or exiting an object.
        surface.isect.worldShadingNor = faceForward(surface.isect.worldShadingNor, -ray.direction); 
    }

    return surface;
}

vec3 Li_Naive(Ray ray)
{
    // The light energy our ray has gathered along its path
    vec3 accumulated_light = vec3(0.f);

    // The light-dampening effect that the surfaces our ray has visited
    // have applied to the ray's ability to transmit energy back to the camera.
    // Need to "remember" the surfaces our ray has hit so that we can appropriately
    // attenuate the color of a light source that we hit.
    vec3 throughput = vec3(1.f);

    for(uint i = 0; i < pc.maxDepth; i++)
    {
        vec3 woW = -1.f * ray.direction;
        SurfaceInteraction surface = sceneIntersect(ray);

        if (surface.isect.t == kMiss)
        {
            // Terminate the path on-miss
            break;
        }

        // If we've hit an emissive surface, we will terminate
        // the ray as we will pretend that light sources have
        // no ability to scatter light, only emit it.
        if (surface.material.emissionColor != vec3(0.f))
        {
            accumulated_light += surface.material.emissionColor * throughput;
            break;
        }

        vec3 wiW;
        float bsdfPdf;
        uint sampledType;

        vec2 xi = vec2(rng(), rng());
        vec3 bsdf = sample_f(surface, woW, xi, wiW, bsdfPdf, sampledType);

        if (bsdfPdf == 0.0 || bsdf == vec3(0.0))
        {
            // Terminate the path if we encounter an invalid sample
            break;
        }

        float lambert = absDot(wiW, surface.isect.worldShadingNor);

        // Record the "memory" of the surface our ray has hit in
        // the ray's overall throughput.
        throughput *= bsdf * lambert / bsdfPdf;

        // To scatter our ray somewhere new, update its origin and direction
        ray = spawnRay(surface.isect.worldPos, wiW);

        // Now the loop repeats, and we intersect this new ray with the scene.
    }

    return accumulated_light;
}
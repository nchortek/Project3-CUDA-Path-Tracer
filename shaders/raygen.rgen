#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "gpu/shared.h"
#include "common.glsl"
#include "rng.glsl"

layout(set = kRendererDescriptorSet, binding = kTLASBinding) uniform accelerationStructureEXT TLAS;
layout(set = kRendererDescriptorSet, binding = kAccumImageBinding, rgba32f) uniform image2D accumImage;
layout(set = kRendererDescriptorSet, binding = kDisplayImageBinding, rgba8) uniform image2D displayImage;

layout(push_constant, scalar) uniform PushConstantBlock
{
    PushConstants pc;
};

// Raygen owns the payload, so this is rayPayloadEXT rather than the
// rayPayloadInEXT used by our closest-hit and miss shaders.
// The location must match the last argument of traceRayEXT.
layout(location = 0) rayPayloadEXT IntersectionInfo isect;

void main()
{
    initSeed(gl_LaunchIDEXT, gl_LaunchSizeEXT, pc.renderedFrameCount);

    // gl_LaunchIDEXT (0,0) is the top-left image pixel,
    // and +y increases down the screen.
    const vec2 pixel = vec2(gl_LaunchIDEXT.xy);
    const vec2 halfResolution = vec2(gl_LaunchSizeEXT.xy) * 0.5;

    // NCHORTEK TODO: This needs to be consistent with saveImage pixel calcs
    const vec3 direction = normalize(
        pc.camera.view
        + pc.camera.right * pc.camera.pixelLength.x * (pixel.x - halfResolution.x)
        - pc.camera.up * pc.camera.pixelLength.y * (pixel.y - halfResolution.y));
    
    // Set the miss sentinel before tracing, so a miss is correct even for traces
    // where no shader writes the payload
    isect.t = kMiss;

    traceRayEXT(
        TLAS,
        gl_RayFlagsNoneEXT,
        kInstanceMaskAllBitsSet,
        0,
        0,
        0,
        pc.camera.position,
        kTMin,
        direction,
        kTMax,
        0);

    vec3 color = vec3(0.0);
    if (isect.t != kMiss)
    {
        SceneAddresses sceneAddresses = SceneAddressesBuffer(pc.sceneAddr).deviceAddresses;
        GpuMaterial material = MaterialBuffer(sceneAddresses.materialsAddr).materials[isect.materialIndex];
        color = material.baseColor;

        // NCHORTEK TODO: Might want to add a gui toggle for enabling some debug views
        //color = isect.worldShadingNor * 0.5 + 0.5;
        color = vec3(rng());
    }

    imageStore(displayImage, ivec2(pixel), vec4(color, 1.0));
}
